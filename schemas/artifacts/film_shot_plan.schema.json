{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "StoryMind/artifacts/film_shot_plan",
  "type": "object",
  "required": ["version", "story_fingerprint", "shots"],
  "properties": {
    "version": {"const": "1.0"},
    "story_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "shots": {"type": "array", "minItems": 1, "items": {
      "type": "object",
      "required": ["id", "scene_id", "duration_seconds", "location", "description", "camera", "lighting", "characters", "video_prompt"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "scene_id": {"type": "string"},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "location": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "camera": {"type": "string", "minLength": 1},
        "lighting": {"type": "string", "minLength": 1},
        "video_prompt": {"type": "string", "minLength": 1},
        "characters": {"type": "array", "items": {
          "type": "object", "required": ["id", "outfit_id", "state", "position"],
          "properties": {"id": {"type": "string"}, "outfit_id": {"type": "string"},
            "state": {"type": "string"}, "position": {"type": "string"}},
          "additionalProperties": false}
        }
      }, "additionalProperties": false}
    }
  }, "additionalProperties": false
}
