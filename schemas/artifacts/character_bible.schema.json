{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "StoryMind/artifacts/character_bible",
  "title": "Character Film Cast Bible",
  "type": "object",
  "required": ["version", "story_fingerprint", "characters"],
  "properties": {
    "version": {"const": "1.0"},
    "story_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "characters": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "age_category", "source", "fictionalization_level", "identity", "outfits", "required_outfits", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "display_name": {"type": "string"},
          "role": {"type": "string", "minLength": 1},
          "age_category": {"enum": ["minor", "adult", "unspecified"]},
          "visual_importance": {"enum": ["principal", "supporting", "background"]},
          "dialogue_required": {"type": "boolean"},
          "scene_count": {"type": "integer", "minimum": 0},
          "required_state_changes": {"type": "array", "items": {"type": "string"}},
          "description": {"type": "string"},
          "selected_candidate_id": {"type": "string"},
          "source": {
            "type": "object",
            "required": ["type", "privacy_classification", "source_photos_local_only", "remote_character_creation_allowed", "downstream_use_original_photos"],
            "properties": {
              "type": {"enum": ["description", "private_family_photo", "other_photo"]},
              "privacy_classification": {"enum": ["PUBLIC", "PRIVATE", "FAMILY_PRIVATE"]},
              "source_photos_local_only": {"type": "boolean"},
              "remote_character_creation_allowed": {"type": "boolean"},
              "remote_character_creation_approval": {"type": "object", "required": ["approved_by", "approved_at", "provider"], "properties": {"approved_by": {"type": "string"}, "approved_at": {"type": "string", "format": "date-time"}, "provider": {"type": "string"}}, "additionalProperties": false},
              "downstream_use_original_photos": {"type": "boolean"},
              "downstream_original_approval": {"type": "object", "required": ["approved_by", "approved_at", "provider"], "properties": {"approved_by": {"type": "string"}, "approved_at": {"type": "string", "format": "date-time"}, "provider": {"type": "string"}}, "additionalProperties": false}
            },
            "additionalProperties": false
          },
          "fictionalization_level": {"type": "integer", "minimum": 1, "maximum": 5},
          "identity": {
            "type": "object",
            "properties": {"master": {"type": "string"}, "face": {"type": "string"}, "full_body": {"type": "string"}, "three_quarter": {"type": "string"}, "side": {"type": "string"}},
            "additionalProperties": false
          },
          "identity_hashes": {"type": "object", "required": ["master", "full_body"], "properties": {"master": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "full_body": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false},
          "outfits": {"type": "object", "additionalProperties": {"type": "object", "required": ["reference", "locked"], "properties": {"reference": {"type": "string"}, "locked": {"type": "boolean"}, "reference_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false}},
          "required_outfits": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "status": {"enum": ["DRAFT", "AWAITING_APPROVAL", "LOCKED"]},
          "identity_locked": {"type": "boolean"},
          "approval": {"type": "object", "required": ["approved_by", "approved_at"], "properties": {"approved_by": {"type": "string"}, "approved_at": {"type": "string", "format": "date-time"}}, "additionalProperties": false}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
